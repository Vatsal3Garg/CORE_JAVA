package core.main;


class ConsOverLoading {

	private int id, salary;
	private String name, gender;
	
	
	public ConsOverLoading() {
		System.out.println("Default.Default()");
	}


	public ConsOverLoading(String name) {
		this();
		this.name = name;
		System.out.println("Constructor.Constructor(1)");
	}


	public ConsOverLoading(String name, String gender) {
		this(name);
		this.gender = gender;
		System.out.println("Constructor.Constructor(2)");
	}
	


}



public class ConstructorChainingandOverloading {

	public static void main(String[] args) {
		
		
		
		
		ConsOverLoading c1 = new ConsOverLoading("vatsal");
		ConsOverLoading c2 = new ConsOverLoading("vatsal", "male");

	}

}
