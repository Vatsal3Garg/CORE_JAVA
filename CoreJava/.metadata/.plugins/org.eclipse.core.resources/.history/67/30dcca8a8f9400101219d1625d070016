package core.main;

public class PosInInfiniteArray {
	
	
	
	public static int CountSize(int[] arr) {
		
		int c = 0;
		for (int a : arr) {
			c++;
		}
		
		
		
		
		
		return c;
		
	}
	
	
	public static int PosInArr(int[] arr, int target) {
		int s = 0;
		int size = CountSize(arr);
		int e = size -1 ;
		while (s <= e) {
			int mid = s + (e - s)/2;
			if (target < arr[mid]) {
				e = mid -1;
				
			}
			else if (target > arr[mid]) {
				s = mid + 1;
				
			}else if(target == arr[mid]) {
				return mid;
			}
		}
		return -1;
		
	}

	public static void main(String[] args) {
		int[] ar = {1,4,7,19,21,26,45,67,89};
		int ta = 21;
		System.out.println( PosInArr(ar, ta));

	}

}
