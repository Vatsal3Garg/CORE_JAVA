package core.main;

public class FirstAndLastIndex {
	

	
	public static int FirstandLast(int[] arr , int target)
	{
		int e = 0;
		int s = 0;
		for(int i = 0; i<=arr.length; i++) {
			
			if(target == arr[i]) {
				s = i;
				
				if(i != arr.length - 1) {
					if (arr[i + 1]== target ) {
						e = i + 1;
						i++;
						
					}else {
						s = e;
										}
				}
				
			}else if(target < arr[i]){
				break;
         }else{
            s = -1 ;
            e = -1;
			
		}
		return s;
		}
		
		
	}
	public static void main(String[] args) {
		int[] ar = {5, 7, 7, 8 , 8, 10};
		int tar = 8;
		System.out.println(FirstandLast(ar , tar));
		

	}

}