	public static int PosInArr(int[] arr, int target ) {
		int s = 0;
		for(int k = 0 ; k < 15; k++) {
			int e = 2^k;
			int m = s + (e - s)/2;
			while(s < e) {
				if (target < arr[m]) {
					e = m -1;
					
				}
				else if (target > arr[m]) {
					s = m + 1;
					
				}else if(target == arr[m]) {
					return m;
				}
			}
			
		}
		return -1;
	}

	public static void main(String[] args) {
		int[] ar = {1,4,7,19,21,26,45,67,89};
		int ta = 21;
		System.out.println( PosInArr(ar, ta));

	}

