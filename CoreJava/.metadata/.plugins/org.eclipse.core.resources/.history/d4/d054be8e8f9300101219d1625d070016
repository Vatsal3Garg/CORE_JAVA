package core.main;


class Person{
	 private String name;
	 private int age;
	 private String add;
	 private int num;
	 private int sal;
	
	public void print() {
		System.out.println("Name is : " + name);
		System.out.println("Age is : " + age);
		System.out.println("Address is : " + add);
		System.out.println("Phn Number is : " + num);
		System.out.println("Salary is : " + sal);
	}
	 public void setter(String name, int age, String add, int num,  int sal) {
		 
		 this.name = name;
		 this.age = age;
		 this.add = add;
		 this.num = num;
		 this.sal = sal;
		 
		 
	 }
	
	 Person(){ // default constructor 
		 
	 }
	 
	 Person(String name, int age, String add, int num,  int sal){ // overloaded constructor
		 
		 this.name = name;
		 this.age = age;
		 this.add = add;
		 this.num = num;
		 this.sal = sal;
		 
	 }
	
	
}






public class GettersAndSetters {

	public static void main(String[] args) {
		
		Person vatsal = new Person();
		                  //Default Constructor
		
//      Reference Variable = Object Creation 
//      Stack Memory         Heap Memory
		
		
		
// to access non public or private properties or variable their are two ways:
		
		
	// 1. Make a function(setter) which assign all the values
	//     of actual parameters in formal parameters or private prop.	
		
		
		vatsal.setter("Vatsal Garg", 23, "Ghaziabad",23450, 12000);
		vatsal.print();
		
		
		
	// 2. During object Creation a default constructor is called which can be 
    //    used to pass actual parameters and we can also overload it according to 
    //    requirement also constructor call only once at a time of object creation
		
		
		Person Onu = new Person("Onu garg", 23, "Ghaziabad",23, 1000000);
		Onu.print();
		
		
	}

}

