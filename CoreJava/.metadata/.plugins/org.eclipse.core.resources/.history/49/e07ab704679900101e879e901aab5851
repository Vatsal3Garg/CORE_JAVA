//https://www.geeksforgeeks.org/dsa/find-position-element-sorted-array-infinite-numbers/
public class SearchInInfiniteArray {

	
	
	
     static int ans(int[] arr, int target ) {	
    	 
    	 
    	 int start = 0;
    	 int end = 1;
    	 
    	 while(target > arr[end]) {
    		 
    		 
    		 int temp = end + 1;
    		 
    		 
    		 end = end + (end - start + 1)*2;
    		 start = temp;
    	 }
    	 
    	 
    	 int a = BinarySea(arr , target , start , end);
    	 
    	 
    	 return a;
		
	}
     
     
     static int BinarySea(int [] arr , int target , int s, int e) {
    	 
    	
    	 
    	 
    	 while(s <= e) {
    		 
    		 int m = s + (e-s)/2;
    		 if(target > arr[m]) {
    			 s = m +1 ;
    			 
    		 }else if(s >= e) {
    			 e = m -1;
    			 
    		 }else if(target == arr[m]) {
    			 return m;
    		 }
    	 }
    	 
    	 return -1;
    	 
    	 
     }
