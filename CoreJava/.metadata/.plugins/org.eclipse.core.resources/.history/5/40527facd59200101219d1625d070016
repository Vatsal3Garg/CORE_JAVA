package core.main;

public class FirstAndLastIndex {
	
	
	public int[] FirstandLast(int[] arr , int target)
	{
		
		for(int i = 0; i< arr.length; i++) {
			int e = 0;
			int s = 0;
			if(target == arr[i]) {
				s = i;
				if (arr[i + 1]== target ) {
					e = i + 1;
					i++;
					
				}else {
					s = e;
					return new int[s,e];
				}
			}
		}
		
		
	}
